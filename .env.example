# Application
APP_ENV=development
APP_NAME=checkup-miniapp
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Backend security - replace locally, never commit real values
JWT_SECRET=change-me

# PostgreSQL
POSTGRES_DB=checkup
POSTGRES_USER=checkup
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://checkup:change-me@127.0.0.1:5432/checkup

# WeChat Mini Program
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Tencent COS
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=

# OCR
OCR_PIPELINE_VERSION=
OCR_WORKER_CONCURRENCY=1
OCR_WORK_DIR=./runtime/ocr
