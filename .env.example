# Application
APP_ENV=development
APP_NAME=checkup-miniapp
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Backend security - replace locally, never commit real values
JWT_SECRET=change-me

# Independent single administrator; hash generated locally, distinct secret >=32 characters
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# PostgreSQL
POSTGRES_DB=checkup
POSTGRES_USER=checkup
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://checkup:change-me@127.0.0.1:5432/checkup

# WeChat Mini Program
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Tencent COS
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=

# OCR
OCR_WORKER_CONCURRENCY=1
OCR_TASK_LEASE_SECONDS=1800
OCR_WORK_DIR=./runtime/ocr
OCR_NORMAL_PYTHON=.venv/Scripts/python.exe
OCR_PADDLE_PYTHON=.venv-paddle/Scripts/python.exe
OCR_PAGE_TIMEOUT_SECONDS=1800
